<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Anchor.Core\Anchor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\anchor.ico" />
    <Resource Include="Assets/anchor-256.png" />
    <Resource Include="Assets\claude-sync-task.md" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\anchor.ico</ApplicationIcon>
    <AssemblyName>Anchor</AssemblyName>
    <Version>1.3.1</Version>
    <Product>Anchor</Product>
    <Company>James Neville</Company>
    <Description>Anchor keeps you oriented: meeting alerts, a merged agenda, inbox triage and day planning.</Description>
  </PropertyGroup>

</Project>
